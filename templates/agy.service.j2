[Unit]
Description=Antigravity Mesh Node Daemon (FastMCP)
After=network.target

[Service]
Type=simple
User={{ USER }}
WorkingDirectory={{ WORKDIR }}
Environment=PYTHONPATH={{ WORKDIR }}
ExecStart={{ VENV_DIR }}/bin/python3 -m uvicorn core.server:app --host 0.0.0.0 --port {{ PORT }}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
